# ResearchMind Cloud Web — shared Cloud Platform API (Desktop + Web)
VITE_APP_NAME=ResearchMind Cloud
VITE_CLOUD_API_BASE_URL=https://researchmind.pages.dev/api/v1
VITE_AUTH_REQUIRED=true
VITE_DEFAULT_LOCALE=en

# Clerk Auth (same project as Desktop — preferred for email login)
VITE_CLERK_PUBLISHABLE_KEY=

# Gateway shared token (optional fallback, same as Desktop)
VITE_GATEWAY_SHARED_TOKEN=
VITE_GATEWAY_URL=https://researchmind.pages.dev/api/v1

# Firebase Auth (optional fallback)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_CLOUD_SYNC_URL=
