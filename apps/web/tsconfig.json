{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@researchmind/types": ["../../packages/types/src/index.ts"],
      "@researchmind/api": ["../../packages/api/src/index.ts"],
      "@researchmind/ui": ["../../packages/ui/src/index.ts"],
      "@researchmind/utils": ["../../packages/utils/src/index.ts"],
      "@researchmind/config": ["../../packages/config/src/index.ts"],
      "@researchmind/sync": ["../../packages/sync/src/index.ts"],
      "@researchmind/i18n": ["../../packages/i18n/src/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"]
    }
  },
  "include": ["src", "../../packages/types/src", "../../packages/api/src", "../../packages/ui/src", "../../packages/utils/src", "../../packages/config/src", "../../packages/sync/src"]
}
