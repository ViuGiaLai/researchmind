# ResearchMind Cloud Gateway

ENVIRONMENT=development
ALLOW_UNAUTHENTICATED=true
CORS_ORIGINS=http://localhost:1420,tauri://localhost

# Public Desktop Client Configuration (served at GET /v1/client-config)
# Clerk's publishable key is public by design. Do not put Clerk Secret Keys,
# provider API keys, or service-account credentials in these settings.
FRONTEND_CLERK_PUBLISHABLE_KEY=
FRONTEND_CLOUD_SYNC_URL=http://localhost:8787/api
FRONTEND_REPORTS_API_URL=http://localhost:8788/api/v1
FRONTEND_CLIENT_CONFIG_VERSION=1
FRONTEND_CONFIG_GENERATED_AT=
FRONTEND_FEATURE_FLAGS={"cloudSync":true,"reports":true}

# Shared Token
# Generate a random 32-64 character secret.
# Example:
#   openssl rand -hex 32
#   https://passwordsgenerator.net/
GATEWAY_SHARED_TOKEN=

# Firebase
# Firebase Console:
# https://console.firebase.google.com/
#
# Project Settings -> General -> Project ID
FIREBASE_PROJECT_ID=

# Firebase Console:
# Project Settings -> Service Accounts
# -> Generate new private key
#
# If your code uses:
# credentials.Certificate(path)
# then put the path:
#   ./serviceAccountKey.json
#
# If your code uses:
# json.loads(...)
# then paste the entire JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Quota
FREE_REQUESTS_PER_DAY=30
FREE_INPUT_CHARS_PER_DAY=500000
MAX_INPUT_CHARS=120000
MAX_OUTPUT_TOKENS=4096
PROVIDER_TIMEOUT=120.0

# Google Gemini
# https://aistudio.google.com/apikey
# Create API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq
# https://console.groq.com/keys
# Create API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
# https://openrouter.ai/keys
# Create API Key
OPENROUTER_API_KEY=

# Optional.
# Can use the same key as OPENROUTER_API_KEY.
OPENROUTER_R1_API_KEY=

OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_R1_MODEL=deepseek/deepseek-r1

# Cerebras
# https://cloud.cerebras.ai/
# API Keys -> Create API Key
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# Cloudflare Workers AI
# API Token:
# https://dash.cloudflare.com/profile/api-tokens
#
# Worker URL:
# Workers & Pages -> Your Worker
# https://<worker>.workers.dev
CLOUDFLARE_API_KEY=
CLOUDFLARE_URL=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Anthropic Claude
# https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# DeepSeek
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# GitHub Models
# https://github.com/settings/personal-access-tokens
# Generate Fine-grained Personal Access Token.
GITHUB_API_KEY=

# Optional.
# Can reuse GITHUB_API_KEY.
GITHUB_DEEPSEEK_V3_API_KEY=

GITHUB_MODEL=gpt-4o-mini
GITHUB_DEEPSEEK_V3_MODEL=DeepSeek-V3-0324

# NVIDIA Build
# https://build.nvidia.com/
# API Keys -> Generate API Key
NVIDIA_API_KEY=

# Optional.
# Can reuse NVIDIA_API_KEY.
NVIDIA_DEEPSEEK_API_KEY=

NVIDIA_MODEL=moonshotai/kimi-k2.6
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro

# FreeModel (optional)
FREEMODEL_API_KEY=
FREEMODEL_MODEL=gpt-4o-mini

# Cohere
# https://dashboard.cohere.com/api-keys
# Create API Key
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

TASK_PROVIDER_MAP={"chat":"gemini","rag":"gemini","summary":"groq","daily_reader":"github","review":"nvidia_deepseek","review_outline":"groq","review_section":"groq","verify":"gemini","critique":"gemini","debate":"nvidia_deepseek","gap":"nvidia_deepseek","insight":"github","quality_check":"github","research":"groq","synthesis":"groq","entity":"cerebras","translate":"gemini"}

ROUTING_POLICY={"chat.fast":["gemini","github","groq"],"chat.deep":["deepseek","openrouter","nvidia_deepseek","gemini"],"chat.deep_plus":["openrouter_r1","deepseek","nvidia_deepseek","gemini"],"rag.fast":["gemini","groq","cerebras"],"rag.deep":["deepseek","gemini","nvidia"],"rag.deep_plus":["openrouter_r1","deepseek","gemini"],"review_outline":["groq","gemini","cerebras"],"review_section":["nvidia_deepseek","deepseek","gemini","groq"],"review":["nvidia_deepseek","deepseek","gemini"],"verify":["gemini","deepseek","groq"],"critique":["gemini","deepseek","nvidia"],"debate":["nvidia_deepseek","deepseek","gemini"],"summary":["groq","gemini","cerebras"],"quality_check":["github","gemini","groq"],"translate":["gemini","groq"],"entity":["cerebras","groq"],"research":["deepseek","groq","gemini"],"synthesis":["deepseek","groq","gemini"],"daily_reader":["github","gemini","groq"],"gap":["deepseek","nvidia_deepseek","gemini"],"insight":["github","gemini","groq"]}

PROVIDER_FALLBACK_CHAIN=groq,cerebras,cloudflare,nvidia,nvidia_deepseek,github,github_deepseek_v3,cohere,openrouter,openrouter_r1,deepseek,freemodel,claude